# Copia este archivo como .env y completa los valores.
DISCORD_TOKEN=PEGA_AQUI_EL_TOKEN_DEL_BOT
CLIENT_ID=ID_DE_LA_APLICACION_DISCORD
GUILD_ID=ID_DE_TU_SERVIDOR
OWNER_ID=TU_ID_DE_USUARIO_DISCORD

# Opcional: ID de una categoría donde se crearán los canales privados.
# Si se deja vacío, se crean en la categoría predeterminada del servidor.
DELIVERY_CATEGORY_ID=

# Ruta local al archivo PEM. NO lo subas a GitHub ni lo compartas.
LICENSE_PRIVATE_KEY_PATH=./secrets/ALEXITO_LICENSE_PRIVATE_KEY.pem
